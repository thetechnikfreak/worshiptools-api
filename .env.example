# ==========================================
# ChurchTools Configuration
# ==========================================
CT_URL=https://your-church.church.tools
CT_TOKEN=your_churchtools_user_token

# ==========================================
# WorshipTools Configuration
# ==========================================
WORSHIPTOOLS_EMAIL=admin@your-church.org
WORSHIPTOOLS_PASSWORD=your_worshiptools_password
WORSHIPTOOLS_ACCOUNT_ID=your_worshiptools_account_uuid

# ==========================================
# Security & Network (Optional)
# ==========================================
# Protects incoming REST API endpoints (/api/upload, /api/sync, etc.)
# If left empty, endpoints accept unauthenticated requests
SYNC_API_KEY=

# Server Port (default: 5000)
PORT=5000

# Path to persistent SQLite state database
SYNC_STATE_DB=/data/sync_state.sqlite

# Path to YAML configuration file
CONFIG_PATH=config.yaml
